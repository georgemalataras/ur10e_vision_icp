<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur10e_workcell">

  <!-- GROUPS -->
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tcp_link" />
  </group>

  <group name="gripper">
    <link name="robotiq_85_base_link" />
    <link name="robotiq_85_left_knuckle_link" />
    <link name="robotiq_85_right_knuckle_link" />
    <link name="robotiq_85_left_finger_link" />
    <link name="robotiq_85_right_finger_link" />
    <link name="robotiq_85_left_inner_knuckle_link" />
    <link name="robotiq_85_right_inner_knuckle_link" />
    <link name="robotiq_85_left_finger_tip_link" />
    <link name="robotiq_85_right_finger_tip_link" />
    <joint name="robotiq_85_left_knuckle_joint" />
  </group>

  <!-- END EFFECTOR -->
  <end_effector name="gripper_ee" parent_link="tcp_link" group="gripper" parent_group="ur_manipulator" />

  <!-- GROUP STATES (Named Poses) -->
  <!-- 1. Home / Upright -->
  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0.0" />
    <joint name="shoulder_lift_joint" value="-1.5707" />
    <joint name="elbow_joint" value="0.0" />
    <joint name="wrist_1_joint" value="-1.5707" />
    <joint name="wrist_2_joint" value="0.0" />
    <joint name="wrist_3_joint" value="0.0" />
  </group_state>

  <!-- 2. Ready (Facing table, arm poised) -->
  <group_state name="ready" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0.0" />
    <joint name="shoulder_lift_joint" value="-1.0" />
    <joint name="elbow_joint" value="1.5707" />
    <joint name="wrist_1_joint" value="-2.14" />
    <joint name="wrist_2_joint" value="-1.5707" />
    <joint name="wrist_3_joint" value="0.0" />
  </group_state>

  <!-- 3. Pre-grasp (Hovering 15cm vertically above red cube at x=0.85, y=0.0) -->
  <group_state name="pre_grasp" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="-0.2063" />
    <joint name="shoulder_lift_joint" value="-1.232" />
    <joint name="elbow_joint" value="1.7062" />
    <joint name="wrist_1_joint" value="-2.0451" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="1.3645" />
  </group_state>

  <!-- 4. Grasp (Down directly over red cube at x=0.85, y=0.0, z=0.835) -->
  <group_state name="grasp" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="-0.2063" />
    <joint name="shoulder_lift_joint" value="-1.0972" />
    <joint name="elbow_joint" value="1.8092" />
    <joint name="wrist_1_joint" value="-2.2828" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="1.3645" />
  </group_state>

  <!-- 5. Lift (Raised vertically with cube) -->
  <group_state name="lift" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="-0.2063" />
    <joint name="shoulder_lift_joint" value="-1.232" />
    <joint name="elbow_joint" value="1.7062" />
    <joint name="wrist_1_joint" value="-2.0451" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="1.3645" />
  </group_state>

  <!-- 6. Place (Lowered to place target at x=0.85, y=0.25, z=0.835) -->
  <group_state name="place" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0.0882" />
    <joint name="shoulder_lift_joint" value="-1.0503" />
    <joint name="elbow_joint" value="1.731" />
    <joint name="wrist_1_joint" value="-2.2515" />
    <joint name="wrist_2_joint" value="-1.5708" />
    <joint name="wrist_3_joint" value="1.659" />
  </group_state>

  <!-- Gripper open/close states -->
  <group_state name="open" group="gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.0" />
  </group_state>

  <group_state name="close" group="gripper">
    <joint name="robotiq_85_left_knuckle_joint" value="0.5" />
  </group_state>

  <!-- VIRTUAL JOINT -->
  <virtual_joint name="fixed_base" type="fixed" parent_frame="world" child_link="pedestal_link" />

  <!-- DISABLE COLLISIONS -->
  <disable_collisions link1="pedestal_link" link2="base_link" reason="Adjacent" />
  <disable_collisions link1="pedestal_link" link2="base_link_inertia" reason="Adjacent" />
  <disable_collisions link1="pedestal_link" link2="shoulder_link" reason="Never" />
  <disable_collisions link1="pedestal_link" link2="table_link" reason="Adjacent" />
  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent" />
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent" />
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent" />
  <disable_collisions link1="upper_arm_link" link2="forearm_link" reason="Adjacent" />
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent" />
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent" />
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never" />
  <disable_collisions link1="wrist_3_link" link2="tool0" reason="Adjacent" />
  <disable_collisions link1="wrist_3_link" link2="ur_to_robotiq_link" reason="Adjacent" />
  <disable_collisions link1="wrist_3_link" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="tool0" link2="ur_to_robotiq_link" reason="Adjacent" />
  <disable_collisions link1="tool0" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="ur_to_robotiq_link" link2="robotiq_85_base_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_inner_knuckle_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="robotiq_85_base_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_finger_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_finger_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_knuckle_link" link2="robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_85_right_knuckle_link" link2="robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_finger_tip_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_right_finger_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_finger_link" link2="robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Adjacent" />
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_inner_knuckle_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="robotiq_85_right_inner_knuckle_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="robotiq_85_left_finger_tip_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />

  <!-- Cube collisions -->
  <disable_collisions link1="red_cube_link" link2="table_link" reason="Adjacent" />
  <disable_collisions link1="red_cube_link" link2="tcp_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
  <disable_collisions link1="red_cube_link" link2="robotiq_85_right_knuckle_link" reason="Never" />

  <!-- Table to gripper collisions (prevents OMPL planning slowdown near tabletop) -->
  <disable_collisions link1="table_link" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_left_knuckle_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_right_knuckle_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_left_finger_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_right_finger_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_left_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_right_inner_knuckle_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_left_finger_tip_link" reason="Never" />
  <disable_collisions link1="table_link" link2="robotiq_85_right_finger_tip_link" reason="Never" />
  <disable_collisions link1="table_link" link2="ur_to_robotiq_link" reason="Never" />
  <disable_collisions link1="table_link" link2="tcp_link" reason="Never" />
  <disable_collisions link1="table_link" link2="tool0" reason="Never" />
  <disable_collisions link1="table_link" link2="wrist_3_link" reason="Never" />
  <disable_collisions link1="table_link" link2="wrist_2_link" reason="Never" />
  <disable_collisions link1="table_link" link2="wrist_1_link" reason="Never" />

  <!-- Camera bracket and wrist camera collisions -->
  <disable_collisions link1="camera_bracket_link" link2="tool0" reason="Adjacent" />
  <disable_collisions link1="camera_bracket_link" link2="wrist_camera_link" reason="Adjacent" />
  <disable_collisions link1="camera_bracket_link" link2="ur_to_robotiq_link" reason="Adjacent" />
  <disable_collisions link1="camera_bracket_link" link2="gripper_mount_link" reason="Adjacent" />
  <disable_collisions link1="camera_bracket_link" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="camera_bracket_link" link2="wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="wrist_camera_link" link2="tool0" reason="Adjacent" />
  <disable_collisions link1="wrist_camera_link" link2="wrist_3_link" reason="Adjacent" />
  <disable_collisions link1="wrist_camera_link" link2="gripper_mount_link" reason="Adjacent" />
  <disable_collisions link1="wrist_camera_link" link2="ur_to_robotiq_link" reason="Adjacent" />
  <disable_collisions link1="wrist_camera_link" link2="robotiq_85_base_link" reason="Never" />
  <disable_collisions link1="wrist_camera_link" link2="tcp_link" reason="Never" />
  <disable_collisions link1="wrist_camera_link" link2="table_link" reason="Never" />

</robot>
