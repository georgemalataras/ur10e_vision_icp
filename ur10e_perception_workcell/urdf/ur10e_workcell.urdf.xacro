<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur10e_workcell">

  <!-- Arguments -->
  <xacro:arg name="ur_type" default="ur10e"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:arg name="include_gripper_ros2_control" default="false"/>
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:arg name="sim_gazebo" default="false"/>
  <xacro:arg name="simulation_controllers" default=""/>

  <!-- Include UR robot macro from ur_description -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>

  <!-- Include Robotiq 2F-85 adapter & gripper macros from robotiq_description -->
  <xacro:include filename="$(find robotiq_description)/urdf/ur_to_robotiq_adapter.urdf.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

  <!-- Include Gazebo simulation control if sim_gazebo is true -->
  <xacro:if value="$(arg sim_gazebo)">
    <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.ros2_control.xacro" />
  </xacro:if>

  <!-- World coordinate frame -->
  <link name="world"/>

  <!-- Pedestal base: stands on floor, top at z = 0.75m (just below table surface 0.80m) -->
  <!-- Geometry is excluded from URDF by default and loaded via MoveIt PlanningScene + Gazebo world -->
  <xacro:arg name="include_pedestal" default="false"/>
  <xacro:property name="pedestal_height" value="0.75"/>
  <link name="pedestal_link">
    <xacro:if value="$(arg include_pedestal)">
      <visual>
        <origin xyz="0 0 ${pedestal_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.4 0.4 ${pedestal_height}"/>
        </geometry>
        <material name="pedestal_color">
          <color rgba="0.25 0.25 0.28 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${pedestal_height / 2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.4 0.4 ${pedestal_height}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 ${pedestal_height / 2.0}" rpy="0 0 0"/>
        <mass value="50.0"/>
        <inertia ixx="4.83" ixy="0.0" ixz="0.0" iyy="4.83" iyz="0.0" izz="1.33"/>
      </inertial>
    </xacro:if>
  </link>

  <joint name="world_to_pedestal_joint" type="fixed">
    <parent link="world"/>
    <child link="pedestal_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Pedestal mount surface (at z = 0.75m) -->
  <link name="pedestal_top_link"/>
  <joint name="pedestal_to_top_joint" type="fixed">
    <parent link="pedestal_link"/>
    <child link="pedestal_top_link"/>
    <origin xyz="0 0 ${pedestal_height}" rpy="0 0 0"/>
  </joint>

  <!-- Instantiate UR10e Robot on top of the 0.7m pedestal -->
  <xacro:ur_robot
    name="ur10e"
    tf_prefix="$(arg tf_prefix)"
    parent="pedestal_top_link"
    joint_limits_parameters_file="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"
    kinematics_parameters_file="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"
    safety_limits="false"
    force_abs_paths="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- UR to Robotiq Adapter Flange attached to tool0 -->
  <xacro:ur_to_robotiq
    prefix="$(arg tf_prefix)"
    connected_to="$(arg tf_prefix)tool0"
    rotation="1.570796"/>

  <!-- Robotiq 2F-85 Gripper attached to the adapter flange -->
  <xacro:robotiq_gripper
    name="RobotiqGripperHardwareInterface"
    prefix="$(arg tf_prefix)"
    parent="$(arg tf_prefix)gripper_mount_link"
    include_ros2_control="$(arg include_gripper_ros2_control)"
    use_fake_hardware="$(arg use_fake_hardware)">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:robotiq_gripper>

  <!-- TCP (Tool Center Point) Link: central grasp point between the fingertips -->
  <link name="$(arg tf_prefix)tcp_link"/>
  <joint name="$(arg tf_prefix)tcp_joint" type="fixed">
    <parent link="$(arg tf_prefix)robotiq_85_base_link"/>
    <child link="$(arg tf_prefix)tcp_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>

  <!-- Eye-in-Hand Camera Bracket attached directly to tool0 (robot wrist flange) -->
  <link name="$(arg tf_prefix)camera_bracket_link">
    <!-- Flange mounting plate extending laterally along +X -->
    <visual>
      <origin xyz="0.05 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.05 0.01"/>
      </geometry>
      <material name="bracket_metal">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.05 0 0.005" rpy="0 0 0"/>
      <geometry>
        <box size="0.10 0.05 0.01"/>
      </geometry>
    </collision>
    <!-- Standoff arm extending forward along +Z matching the gripper reach -->
    <visual>
      <origin xyz="0.095 0 0.068" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.045 0.135"/>
      </geometry>
      <material name="bracket_metal">
        <color rgba="0.25 0.25 0.28 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.095 0 0.068" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.045 0.135"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.07 0 0.05" rpy="0 0 0"/>
      <mass value="0.08"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.00005"/>
    </inertial>
  </link>

  <joint name="$(arg tf_prefix)camera_bracket_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child link="$(arg tf_prefix)camera_bracket_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Eye-in-Hand Camera Link mounted solidly on the bracket, pointing along tool0 +Z -->
  <link name="$(arg tf_prefix)wrist_camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
      <material name="camera_case_color">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.025 0.09 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.06"/>
      <inertia ixx="0.00004" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00004"/>
    </inertial>
  </link>

  <joint name="$(arg tf_prefix)wrist_camera_joint" type="fixed">
    <parent link="$(arg tf_prefix)camera_bracket_link"/>
    <child link="$(arg tf_prefix)wrist_camera_link"/>
    <!-- Mounted on bracket arm at x=0.095, z=0.135 (flush with Robotiq fingertips), pointing pitch=-90deg so optical axis looks along +Z -->
    <origin xyz="0.095 0 0.135" rpy="0 -1.570796 0"/>
  </joint>

  <!-- ROS Optical Frame for standard computer vision (Z forward, X right, Y down) -->
  <link name="$(arg tf_prefix)wrist_camera_optical_frame"/>
  <joint name="$(arg tf_prefix)wrist_camera_optical_joint" type="fixed">
    <parent link="$(arg tf_prefix)wrist_camera_link"/>
    <child link="$(arg tf_prefix)wrist_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.570796 0 -1.570796"/>
  </joint>

  <!-- Table & Cube parameters -->
  <xacro:arg name="include_table" default="true"/>
  <xacro:arg name="include_cube" default="true"/>
  <xacro:property name="table_x" value="0.95"/>
  <xacro:property name="table_y" value="0.0"/>
  <xacro:property name="table_length" value="0.8"/>
  <xacro:property name="table_width" value="1.2"/>
  <xacro:property name="table_height" value="0.8"/>
  <xacro:property name="table_top_thick" value="0.05"/>
  <xacro:property name="leg_h" value="${table_height - table_top_thick}"/>
  <xacro:property name="leg_dx" value="${table_length/2.0 - 0.05}"/>
  <xacro:property name="leg_dy" value="${table_width/2.0 - 0.05}"/>

  <!-- Table with 4 legs and tabletop (placed at distance 0.35m from pedestal) -->
  <xacro:if value="$(arg include_table)">
    <link name="table_link">
      <!-- Tabletop -->
      <visual name="tabletop_visual">
        <origin xyz="${table_x} ${table_y} ${table_height - table_top_thick/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${table_length} ${table_width} ${table_top_thick}"/>
        </geometry>
        <material name="tabletop_wood">
          <color rgba="0.55 0.40 0.25 1.0"/>
        </material>
      </visual>
      <collision name="tabletop_collision">
        <origin xyz="${table_x} ${table_y} ${table_height - table_top_thick/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="${table_length} ${table_width} ${table_top_thick}"/>
        </geometry>
      </collision>

      <!-- Leg 1: Front-Left -->
      <visual name="leg_fl_visual">
        <origin xyz="${table_x + leg_dx} ${table_y + leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
        <material name="table_legs">
          <color rgba="0.2 0.2 0.22 1.0"/>
        </material>
      </visual>
      <collision name="leg_fl_collision">
        <origin xyz="${table_x + leg_dx} ${table_y + leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
      </collision>

      <!-- Leg 2: Front-Right -->
      <visual name="leg_fr_visual">
        <origin xyz="${table_x + leg_dx} ${table_y - leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
        <material name="table_legs"/>
      </visual>
      <collision name="leg_fr_collision">
        <origin xyz="${table_x + leg_dx} ${table_y - leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
      </collision>

      <!-- Leg 3: Back-Left -->
      <visual name="leg_bl_visual">
        <origin xyz="${table_x - leg_dx} ${table_y + leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
        <material name="table_legs"/>
      </visual>
      <collision name="leg_bl_collision">
        <origin xyz="${table_x - leg_dx} ${table_y + leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
      </collision>

      <!-- Leg 4: Back-Right -->
      <visual name="leg_br_visual">
        <origin xyz="${table_x - leg_dx} ${table_y - leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
        <material name="table_legs"/>
      </visual>
      <collision name="leg_br_collision">
        <origin xyz="${table_x - leg_dx} ${table_y - leg_dy} ${leg_h/2.0}" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 ${leg_h}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="${table_x} ${table_y} ${table_height/2.0}" rpy="0 0 0"/>
        <mass value="30.0"/>
        <inertia ixx="4.0" ixy="0" ixz="0" iyy="4.0" iyz="0" izz="4.0"/>
      </inertial>
    </link>

    <joint name="world_to_table_joint" type="fixed">
      <parent link="world"/>
      <child link="table_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- Red Cube on table: placed at x=0.85, y=0.0, z=0.825 -->
  <xacro:if value="$(arg include_cube)">
    <link name="red_cube_link">
      <visual>
        <origin xyz="0.85 0 0.825" rpy="0 0 0"/>
        <geometry>
          <box size="0.06 0.06 0.06"/>
        </geometry>
        <material name="red_cube_color">
          <color rgba="0.9 0.1 0.1 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0.85 0 0.825" rpy="0 0 0"/>
        <geometry>
          <box size="0.05 0.05 0.05"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0.85 0 0.825" rpy="0 0 0"/>
        <mass value="0.05"/>
        <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
      </inertial>
    </link>

    <joint name="world_to_cube_joint" type="fixed">
      <parent link="world"/>
      <child link="red_cube_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>
  </xacro:if>

  <!-- Gazebo ros2_control system when simulating in Gazebo -->
  <xacro:if value="$(arg sim_gazebo)">
    <gazebo reference="world">
    </gazebo>
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(arg simulation_controllers)</parameters>
      </plugin>
    </gazebo>

    <xacro:ur_ros2_control
      name="ur10e"
      tf_prefix="$(arg tf_prefix)"
    />

    <!-- Register gripper joints: main knuckle joint has position command; mimic joints are automatically synchronized by gz_ros2_control -->
    <ros2_control name="robotiq_gripper" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="robotiq_85_left_knuckle_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="robotiq_85_right_knuckle_joint">
        <param name="mimic">robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">-1</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="robotiq_85_left_inner_knuckle_joint">
        <param name="mimic">robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">1</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="robotiq_85_right_inner_knuckle_joint">
        <param name="mimic">robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">-1</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="robotiq_85_left_finger_tip_joint">
        <param name="mimic">robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">-1</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="robotiq_85_right_finger_tip_joint">
        <param name="mimic">robotiq_85_left_knuckle_joint</param>
        <param name="multiplier">1</param>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>

    <!-- Stabilize gripper joints in Gazebo so they don't flap around -->
    <gazebo reference="robotiq_85_left_knuckle_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="robotiq_85_right_knuckle_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="robotiq_85_left_inner_knuckle_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="robotiq_85_right_inner_knuckle_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="robotiq_85_left_finger_tip_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>
    <gazebo reference="robotiq_85_right_finger_tip_joint">
      <implicitSpringDamper>true</implicitSpringDamper>
    </gazebo>

    <!-- High friction on fingertip pads so grasped objects do not slip -->
    <gazebo reference="robotiq_85_left_finger_tip_link">
      <mu1>100.0</mu1>
      <mu2>100.0</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0.002</minDepth>
      <maxVel>0.0</maxVel>
    </gazebo>
    <gazebo reference="robotiq_85_right_finger_tip_link">
      <mu1>100.0</mu1>
      <mu2>100.0</mu2>
      <kp>1000000.0</kp>
      <kd>1.0</kd>
      <minDepth>0.002</minDepth>
      <maxVel>0.0</maxVel>
    </gazebo>


    <!-- Eye-in-Hand RGB-D Camera Sensor in Gazebo (Color + Depth + 3D PointCloud) -->
    <gazebo reference="$(arg tf_prefix)wrist_camera_link">
      <sensor name="wrist_camera" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
          <depth_camera>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
          </depth_camera>
        </camera>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>true</visualize>
        <topic>/wrist_camera</topic>
        <gz_frame_id>$(arg tf_prefix)wrist_camera_link</gz_frame_id>
      </sensor>
    </gazebo>

    <!-- Detachable Joint System for picking and placing red_cube in Gazebo -->
    <gazebo>
      <plugin filename="gz-sim-detachable-joint-system"
              name="gz::sim::systems::DetachableJoint">
        <parent_link>$(arg tf_prefix)wrist_3_link</parent_link>
        <child_model>red_cube</child_model>
        <child_link>cube_link</child_link>
        <detach_topic>/cube/detach</detach_topic>
        <attach_topic>/cube/attach</attach_topic>
        <output_topic>/cube/state</output_topic>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
