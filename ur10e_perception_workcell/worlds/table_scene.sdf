<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="table_scene">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin
      filename="gz-sim-contact-system"
      name="gz::sim::systems::Contact">
    </plugin>
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Default Supervisory Camera View -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>2.77 -1.11 1.29 0.0 -0.04 2.35</pose>
        <view_controller>orbit</view_controller>
      </camera>
      <!-- Wrist Camera POV Sub-Window -->
      <plugin filename="ImageDisplay" name="Wrist Camera POV">
        <gz-gui>
          <title>Wrist Camera (POV)</title>
          <property key="state" type="string">floating</property>
          <property type="double" key="width">340</property>
          <property type="double" key="height">280</property>
          <property type="double" key="x">10</property>
          <property type="double" key="y">110</property>
          <property type="bool" key="resizable">true</property>
          <property type="bool" key="showTitleBar">true</property>
        </gz-gui>
        <topic>/wrist_camera/image</topic>
        <topic_picker>false</topic_picker>
      </plugin>
    </gui>

    <!-- Sun light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>10 10</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Robot Base Pedestal Model (0.4 x 0.4 x 0.75 m at origin) -->
    <model name="pedestal">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="pedestal_link">
        <collision name="pedestal_collision">
          <pose>0 0 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.4 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="pedestal_visual">
          <pose>0 0 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.4 0.4 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.25 0.25 0.28 1</ambient>
            <diffuse>0.25 0.25 0.28 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 4-Legged Industrial Table Model -->
    <model name="table">
      <static>true</static>
      <pose>0.95 0 0 0 0 0</pose>
      <link name="table_link">
        <!-- Tabletop -->
        <collision name="tabletop_collision">
          <pose>0 0 0.775 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 1.2 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="tabletop_visual">
          <pose>0 0 0.775 0 0 0</pose>
          <geometry>
            <box>
              <size>0.8 1.2 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.40 0.25 1</ambient>
            <diffuse>0.55 0.40 0.25 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>

        <!-- Leg 1: Front-Left -->
        <collision name="leg_fl_collision">
          <pose>0.35 0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_fl_visual">
          <pose>0.35 0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>

        <!-- Leg 2: Front-Right -->
        <collision name="leg_fr_collision">
          <pose>0.35 -0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_fr_visual">
          <pose>0.35 -0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>

        <!-- Leg 3: Back-Left -->
        <collision name="leg_bl_collision">
          <pose>-0.35 0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_bl_visual">
          <pose>-0.35 0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>

        <!-- Leg 4: Back-Right -->
        <collision name="leg_br_collision">
          <pose>-0.35 -0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
        </collision>
        <visual name="leg_br_visual">
          <pose>-0.35 -0.55 0.375 0 0 0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.75</size>
            </box>
          </geometry>
          <material>
            <ambient>0.2 0.2 0.22 1</ambient>
            <diffuse>0.2 0.2 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
